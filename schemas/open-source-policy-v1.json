{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentgitops.dev/schemas/open-source-policy-v1.json",
  "title": "AgentGitOps Open Source Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "publicRepository",
    "publicDefaultBranch",
    "license",
    "releaseModel",
    "forbiddenPaths",
    "requiredChecks"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "publicRepository": { "type": "string", "minLength": 1 },
    "publicDefaultBranch": { "const": "main" },
    "license": { "const": "Apache-2.0" },
    "releaseModel": { "const": "curated-snapshot-and-cherry-pick" },
    "forbiddenPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "requiredChecks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}

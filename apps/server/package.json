{
  "name": "@agentgitops/server",
  "version": "0.1.0",
  "description": "Control Plane server for agentgitops — Node.js HTTP + SSE",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/terrymyth/agentgitops-open.git",
    "directory": "apps/server"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist coverage"
  },
  "dependencies": {
    "@agentgitops/core": "workspace:*",
    "@agentgitops/git": "workspace:*",
    "@agentgitops/local-hub": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "vitest": "4.1.10",
    "rimraf": "^6.0.1"
  }
}
